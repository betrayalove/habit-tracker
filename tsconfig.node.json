{
  "compilerOptions": {
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "target": "ES2022",
    "types": [
      "node"
    ],
    "strict": true
  },
  "include": [
    "vite.config.ts",
    "playwright.config.ts",
    "e2e/**/*.ts"
  ]
}
